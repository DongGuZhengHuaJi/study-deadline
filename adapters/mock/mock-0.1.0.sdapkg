{"format":"study-deadline-adapter/1","keyId":"dev-2026","manifestJson":"{\n  \"schemaVersion\": 1,\n  \"id\": \"mock\",\n  \"name\": \"SDK Mock Adapter\",\n  \"version\": \"0.1.0\",\n  \"apiVersion\": 1,\n  \"minHostVersion\": \"0.1.0\",\n  \"entry\": \"index.js\",\n  \"permissions\": {\n    \"http\": [],\n    \"session\": []\n  },\n  \"auth\": {\n    \"loginUrl\": \"https://example.invalid/login\",\n    \"allowedOrigins\": [],\n    \"sessionCookies\": []\n  },\n  \"keyId\": \"dev-2026\",\n  \"sequence\": 1\n}\n","source":"// SDK smoke-test adapter. It deliberately performs no network access.\n// The desktop app loads this through the QuickJS adapter runtime.\nglobalThis.adapter = {\n  fetchTasks(ctx) {\n    ctx.log.info(\"mock adapter started\");\n    const now = Date.now();\n    return {\n      complete: true,\n      tasks: [\n        {\n          remoteId: \"sdk-smoke-1\",\n          title: \"适配器 SDK 自检任务\",\n          course: \"Mock 课程\",\n          kind: \"assignment\",\n          dueAt: now + 60 * 60 * 1000,\n          status: \"pending\",\n          completed: false,\n          url: \"\",\n        },\n      ],\n    };\n  },\n};\n","signature":"Lo7TnGfxlyE5NS9JIicOES9lEf1IaAC3kJM5jqbb6ooMnhV2w25m598gfo0LUv7BTq5efkZTvFZ6KsvNDI3eBw=="}
